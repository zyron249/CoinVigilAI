APP_ENV=development
API_PORT=8000
WEB_PORT=3000
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# Optional CoinGecko Demo/Pro key. Demo header is used unless the base URL is pro-api.coingecko.com.
COINGECKO_API_KEY=

# Comma-separated browser origins allowed to call the API.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Redis cache TTL for CoinGecko payloads. API still works if Redis is down.
MARKET_CACHE_TTL_SECONDS=30

AI_COUNCIL_ENABLED=true
AI_REQUEST_TIMEOUT_SECONDS=25
AI_PROVIDER_WEIGHTS_JSON=

# Defaults are public catalog IDs, not Cursor model slugs. Change them to match
# the models your provider account can actually call.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional xAI / Grok council member. Leave blank to skip (demo mode stays healthy).
# Official Chat Completions API: POST https://api.x.ai/v1/chat/completions
# Docs: https://docs.x.ai/developers/model-capabilities/legacy/chat-completions
# Catalog: https://docs.x.ai/developers/models  (default grok-4.6 is the current flagship)
# Keys: https://console.x.ai/
XAI_API_KEY=
XAI_MODEL=grok-4.6
XAI_BASE_URL=https://api.x.ai/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Model is required. An API key alone will not enable the adapter.
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
PERPLEXITY_BASE_URL=https://api.perplexity.ai

# OpenRouter also requires an explicit model id.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional public RSS examples:
# NEWS_RSS_URLS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss
NEWS_RSS_URLS=
DATABASE_URL=postgresql://coinvigil:coinvigil@postgres:5432/coinvigil
REDIS_URL=redis://redis:6379/0
NEXT_PUBLIC_API_URL=http://localhost:8000
API_INTERNAL_URL=http://api:8000

# Token Studio factory addresses. Deploy contracts/src/CoinVigilTokenFactory.sol
# to each network before enabling real token creation there.
# These NEXT_PUBLIC_* values are baked in at the Next.js build.
NEXT_PUBLIC_FACTORY_ETHEREUM=
NEXT_PUBLIC_FACTORY_BASE=
NEXT_PUBLIC_FACTORY_BSC=
NEXT_PUBLIC_FACTORY_POLYGON=
NEXT_PUBLIC_FACTORY_ARBITRUM=
